# Ghostty config. Keep a comment on the first line for nvim ft detection

theme = dark:token-dark,light:token-light

font-family = "CommitMono"
font-feature = liga,clig,ss02,ss03,ss04,ss05,cv06,cv08
adjust-cell-height = 35%
adjust-cell-width = -1
font-size = 14

shell-integration-features = no-cursor,ssh-terminfo
cursor-style = block
cursor-style-blink = false
cursor-text = black
adjust-cursor-thickness = 1
window-decoration = server

# MacOS specifics
window-theme = system
macos-option-as-alt = left
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = transparent
