// Zellij theme based on the Lorem Gypsum dark nvim palette
// Copy to ~/.config/zellij/themes/lorem-gypsum-dark.kdl and set
// `theme "lorem-gypsum-dark"` (or theme_dark) in ~/.config/zellij/config.kdl

themes {
    lorem-gypsum-dark {
        text_unselected {
            base 221 221 221
            background 40 40 40
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        text_selected {
            base 221 221 221
            background 38 79 120
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        ribbon_unselected {
            base 144 144 144
            background 46 46 46
            emphasis_0 221 221 221
            emphasis_1 50 50 50
            emphasis_2 217 186 115
            emphasis_3 255 118 118
        }

        ribbon_selected {
            base 34 34 34
            background 86 156 214
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        table_title {
            base 255 255 255
            background 40 40 40
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        table_cell_unselected {
            base 221 221 221
            background 40 40 40
            emphasis_0 255 255 255
            emphasis_1 144 144 144
            emphasis_2 217 186 115
            emphasis_3 255 118 118
        }

        table_cell_selected {
            base 221 221 221
            background 38 79 120
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        list_unselected {
            base 221 221 221
            background 40 40 40
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        list_selected {
            base 221 221 221
            background 38 79 120
            emphasis_0 255 255 255
            emphasis_1 217 186 115
            emphasis_2 134 205 130
            emphasis_3 255 118 118
        }

        frame_unselected {
            base 96 96 96
            background 26 26 26
            emphasis_0 96 96 96
            emphasis_1 255 255 255
            emphasis_2 217 186 115
            emphasis_3 255 118 118
        }

        frame_selected {
            base 255 255 255
            background 40 40 40
            emphasis_0 255 255 255
            emphasis_1 69 142 230
            emphasis_2 217 186 115
            emphasis_3 255 118 118
        }

        frame_highlight {
            base 217 186 115
            background 40 40 40
            emphasis_0 217 186 115
            emphasis_1 255 255 255
            emphasis_2 69 142 230
            emphasis_3 255 118 118
        }

        exit_code_success {
            base 134 205 130
            background 40 40 40
            emphasis_0 134 205 130
            emphasis_1 255 255 255
            emphasis_2 217 186 115
            emphasis_3 255 118 118
        }

        exit_code_error {
            base 255 118 118
            background 40 40 40
            emphasis_0 255 118 118
            emphasis_1 255 255 255
            emphasis_2 217 186 115
            emphasis_3 134 205 130
        }

        multiplayer_user_colors {
            player_1 217 186 115
            player_2 90 191 181
            player_3 242 164 219
            player_4 134 205 130
            player_5 142 190 236
            player_6 255 118 118
            player_7 69 142 230
            player_8 20 186 25
            player_9 255 87 51
            player_10 144 144 144
        }
    }
}
